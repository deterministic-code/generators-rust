{
  "name": "@deterministic-code/rust-generators",
  "version": "0.0.1",
  "description": "Rust generator pack for the deterministic toolchain: the emit-*-rust lane modules and the deterministic runtime crate.",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "rust"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/templates dist/",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --experimental-strip-types --test src/generate-backend-app.integration.test.ts src/generate-datasource-types.integration.test.ts src/common/parse-datasource-types.test.ts"
  },
  "dependencies": {
    "@deterministic-code/generator-sdk": "github:deterministic-code/generators-common",
    "@deterministic-code/patch-merger": "github:deterministic-code/patch-merger",
    "change-case": "^5.4.4",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  }
}
