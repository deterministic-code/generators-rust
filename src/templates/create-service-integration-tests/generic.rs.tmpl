#[cfg(test)]
mod tests {
    use super::{{fileBase}}::*;
    use deterministic::routes::CrudService;
    use deterministic::services::InMemoryDynamicService;
    use deterministic::types::RowMap;
    use serde_json::json;
    use std::sync::Arc;

    fn service() -> {{structName}} {
        {{structName}}::from_inner(Arc::new(InMemoryDynamicService::new()))
    }

    #[tokio::test]
    async fn find_all_returns_empty_on_an_empty_table() {
        let svc = service();
        assert!(CrudService::find_all(&svc).await.unwrap().is_empty());
    }

    #[tokio::test]
    async fn {{addPopulatesTest}}() {
        let svc = service();
        let row = CrudService::add(&svc, RowMap::new()).await.unwrap();
        assert!(row.get("id").is_some());
    }

    #[tokio::test]
    async fn find_returns_none_for_a_missing_id() {
        let svc = service();
        assert!(CrudService::find(&svc, &json!({{&missingId}}))
            .await
            .unwrap()
            .is_none());
    }

    #[tokio::test]
    async fn update_returns_none_for_a_missing_id() {
        let svc = service();
        let result = CrudService::update(&svc, &json!({{&missingId}}), RowMap::new(), None)
            .await
            .unwrap();
        assert!(result.is_none());
    }

    #[tokio::test]
    async fn delete_returns_false_when_the_row_does_not_exist() {
        let svc = service();
        assert!(!CrudService::delete(&svc, &json!({{&missingId}}), None)
            .await
            .unwrap());
    }
}
