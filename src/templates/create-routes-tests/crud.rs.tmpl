mod tests {
    use super::{{fileBase}}::router;
    {{{serviceImport}}}
    use axum::body::Body;
    use axum::http::{Request, StatusCode};
    use deterministic::repositories::inmemory::InMemoryCrudRepository;
    use deterministic::services::GenericCrudService;
    use std::sync::Arc;
    use tower::ServiceExt;

    fn setup() -> axum::Router {
        let inner = GenericCrudService::new(Arc::new(InMemoryCrudRepository::new()));
        router(Arc::new({{className}}::from_inner(Arc::new(inner))))
    }

    #[tokio::test]
    async fn get_{{entitySnake}}_list_returns_200() {
        let res = setup()
            .oneshot(
                Request::builder()
                    .method("GET")
                    .uri("{{mountPath}}")
                    .body(Body::empty())
                    .unwrap(),
            )
            .await
            .unwrap();
        assert_eq!(res.status(), StatusCode::OK);
    }

    #[tokio::test]
    async fn get_{{entitySnake}}_missing_returns_404() {
        let res = setup()
            .oneshot(
                Request::builder()
                    .method("GET")
                    .uri("{{mountPath}}/{{missingId}}")
                    .body(Body::empty())
                    .unwrap(),
            )
            .await
            .unwrap();
        assert_eq!(res.status(), StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn post_{{entitySnake}}_returns_201() {
        let res = setup()
            .oneshot(
                Request::builder()
                    .method("POST")
                    .uri("{{mountPath}}")
                    .header("content-type", "application/json")
                    .body(Body::from(r#"{"name":"{{entitySnake}}-new"}"#))
                    .unwrap(),
            )
            .await
            .unwrap();
        assert_eq!(res.status(), StatusCode::CREATED);
    }

    #[tokio::test]
    async fn put_{{entitySnake}}_missing_is_not_5xx() {
        let res = setup()
            .oneshot(
                Request::builder()
                    .method("PUT")
                    .uri("{{mountPath}}/{{missingId}}")
                    .header("content-type", "application/json")
{{#occ}}                    .header("if-match", "2020-01-01T00:00:00.000Z")
{{/occ}}                    .body(Body::from(r#"{"name":"{{entitySnake}}-updated"}"#))
                    .unwrap(),
            )
            .await
            .unwrap();
        assert!(
            res.status().as_u16() < 500,
            "PUT missing expected non-5xx, got {}",
            res.status()
        );
    }

